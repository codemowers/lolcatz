FROM docker.io/curlimages/curl:8.11.1 AS downloader

WORKDIR /tmp
ARG YOLO_MODEL_URL=https://github.com/ultralytics/assets/releases/download/v8.3.0/yolov8n.pt
RUN curl --fail --location --show-error --silent --output yolov8n.pt "${YOLO_MODEL_URL}"

FROM scratch AS final
COPY --from=downloader /tmp/yolov8n.pt /yolov8n.pt
