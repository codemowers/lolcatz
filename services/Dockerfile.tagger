FROM python:3.12-slim
ENV PGSSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY services/tagger/requirements.txt services/tagger/requirements.lock ./
RUN --mount=type=cache,target=/root/.cache/pip pip install --require-hashes -r requirements.lock \
    && pip install --no-index --no-deps -r requirements.txt

COPY services/worker_runtime.py services/metrics.py services/image_input.py ./
COPY --chmod=0644 services/tagger/tagger.py ./

# Static config baked into the image; only secrets and cluster-specific
# endpoints stay in the chart. /tmp is a writable emptyDir at runtime.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MPLCONFIGDIR=/tmp \
    YOLO_CONFIG_DIR=/tmp \
    YOLO_MODEL_PATH=/models/yolov8n.pt

CMD ["python", "tagger.py"]
